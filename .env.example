# Address on the Panelbook VM where Docker publishes TCP 8765.
# Use the VM's LAN IP, or 0.0.0.0 to listen on every IPv4 interface.
# This is not a client allowlist. Restrict client source IPs with the VM or
# Proxmox firewall; the recommended setup allows only the NGINX VM here.
PANELBOOK_BIND_IP=192.168.1.50
